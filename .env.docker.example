# Copie para .env.docker e preencha. NUNCA versione o .env.docker.
# O host do banco é "db" (nome do serviço no docker-compose).
POSTGRES_USER="rifas"
POSTGRES_PASSWORD="troque-por-uma-senha-forte-do-postgres"
POSTGRES_DB="rifas"
DATABASE_URL="postgresql://rifas:troque-por-uma-senha-forte-do-postgres@db:5432/rifas?schema=public"

# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio-de-32-caracteres"

# Administrador inicial (criado pelo serviço migrate; senha com 10+ caracteres)
ADMIN_NAME="Organizador"
ADMIN_EMAIL="admin@seudominio.com"
ADMIN_PASSWORD="troque-esta-senha-forte"

APP_TIMEZONE="America/Sao_Paulo"

# Opcional: force Secure=true se o proxy TLS não enviar X-Forwarded-Proto.
# COOKIE_SECURE="true"
