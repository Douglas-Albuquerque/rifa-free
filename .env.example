# Banco de dados (produção/local). Use uma senha forte e SSL quando aplicável.
DATABASE_URL="postgresql://rifas:rifas_dev_password@localhost:55432/rifas?schema=public"

# Segredo usado para assinar o cookie de sessão (mínimo 32 caracteres).
# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio-de-32-caracteres"

# Credenciais do administrador inicial (usadas apenas pelo seed).
ADMIN_NAME="Organizador"
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha-forte"

# Opcional: força o atributo Secure do cookie de sessão.
# Em branco, o sistema detecta HTTPS via X-Forwarded-Proto/Origin.
# Defina "true" se o app estiver atrás de um proxy TLS que não envie esses headers.
# COOKIE_SECURE="true"

# Opcional: fuso horário de exibição (padrão America/Sao_Paulo)
APP_TIMEZONE="America/Sao_Paulo"
